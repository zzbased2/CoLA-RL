# Python 虚拟环境
.venv-cola/
.venv/
venv/

# 下载的大模型权重（本地独立下载，不入库）
model/Qwen3-0.6B/
model/Qwen3-1.7B/
model/Qwen3.5-0.8B/
model/Qwen3.5-2B/

